.venv/
__pycache__/
*.pyc

# Local point clouds (large; persona-vectors mirrored on Hugging Face)
data/embeddings/*.npy
data/embeddings/*.parquet
data/embeddings_roles/*.npy
data/embeddings_roles/*.parquet
data/embeddings_aa_traits/*.npy
data/embeddings_aa_traits/*.parquet

# Secrets
token/
.env

# Ignore experiment outputs, but track the scripts that produce them
# (a lost script made the primary E8 result unreproducible — 2026-08-03 review).
# DO NOT add a blanket `output/*` rule below: git never descends into an
# ignored directory, so it would kill `!output/**/` and with it every
# re-include in this file (scripts, manifests, REPORTs) — silently.
# That exact bug hid all geometry-panel provenance until 2026-08-07.
output/**
!output/**/
!output/**/*.py
!output/**/manifest.json
!output/**/results.json
!output/**/REPORT.md
!output/**/RESULTS.md
plans/
data/
exploratory/assistant_axis_traits/
exploratory/persona_vectors/

DESIGN.md
RESEARCH.md

.claude/


# Generated figures are ignored via `exploratory/*/figures/` above.
# (An earlier hint here named `exploratory/figures/`, a path that has never existed.)

# Generated exploratory figures (large plotly HTML; regenerable, kept on disk)
exploratory/*/figures/
.DS_Store

# Refactor verification scratch (large; sha.txt + dirnames stay tracked)
refactors/baselines/*/golden/
refactors/baselines/*/extra-reference/

# Editable-install build artifact
*.egg-info/
.labbook/*
wiki/*
lit-review.md
novelty-assessment.md

exploratory/per_persona/md

