[{"deleteText": {"objectId": "u1113b_01_title", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_01_title", "text": "Update 11/13", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_01_title", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_01_body", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_01_body", "text": "What post-training does to the Assistant and to the roles a model can play, told from the field to my results.\nMy numbers are from OLMo-2-7B. Han Xiao's are from Olmo 3 7B. Other papers name their own model.\nAgent checks only. No human has reviewed these analyses yet.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_01_body", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_01_body", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_01_body", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 20, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_01_body", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"deleteText": {"objectId": "u1113b_02_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_02_heading", "text": "Persona research rests on a few foundations, and the newest work asks about training stages", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_02_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_02_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_02_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_02_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_02_question", "text": "1. The field", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_02_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_02_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_02_result", "text": "A popular view of chat models, the Persona Selection Model, says that pretraining teaches a model many characters and post-training selects one of them, the Assistant.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_02_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_02_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_02_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_02_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_02_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.21589999999999998, "translateX": 40, "translateY": 468.0, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_02_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 94.69782608695652, "scaleY": 94.69782608695652, "translateX": 178.01086956521738, "translateY": 118, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_03_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_03_heading", "text": "Where the Assistant sits among the roles matters for safety", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_03_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_03_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_03_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_03_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_03_question", "text": "2. Why it matters for safety", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_03_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_03_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_03_result", "text": "Lu et al. found that capping activations on the Assistant Axis stabilises behaviour, also against persona-based jailbreaks (larger instruct models).\nWang et al. found a 'toxic persona' feature that controls emergent misalignment (GPT-4o).", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_03_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_03_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_03_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_03_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_03_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.3090333333333333, "translateX": 40, "translateY": 442.42771804062124, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_03_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 137.5931055709449, "scaleY": 133.52449223416966, "translateX": 40.0, "translateY": 89, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_04_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_04_heading", "text": "No paper I read shows when the Assistant becomes privileged, with base models and a words-only control", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_04_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_04_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_04_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_04_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_04_question", "text": "3. What we don't know", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_04_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_04_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_04_result", "text": "Han Xiao and Nguyen study training stages, but not the Assistant's place in the role map with base models and a words-only control.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_04_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_04_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_04_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_04_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_04_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.14393333333333333, "translateX": 40, "translateY": 485.0, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_04_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 108.85714285714286, "scaleY": 108.85714285714286, "translateX": 132.85714285714283, "translateY": 118, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_05_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_05_heading", "text": "I ask at which OLMo-2-7B stage the Assistant becomes privileged", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_05_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_05_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_05_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_05_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_05_question", "text": "4. My question", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_05_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_05_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_05_result", "text": "Privileged means the default sits at one end of the role map, or its replies vary less than a typical role's replies.\nThe answer would show where in training the Assistant gets selected, which the Persona Selection Model leaves open, and so where audits and steering should focus.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_05_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_05_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_05_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_05_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_05_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.3090333333333333, "translateX": 40, "translateY": 446.0, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_05_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 105.83333333333333, "scaleY": 105.83333333333334, "translateX": 142.5, "translateY": 89, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_06_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_06_heading", "text": "Three concurrent works covered parts of my plan, so I narrowed it", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_06_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_06_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_06_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_06_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_06_question", "text": "5. The pivot", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_06_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_06_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_06_result", "text": "I narrowed my work to what they leave open: base models, text baselines across stages and OLMo-2's own stages. I also re-checked Han Xiao's result on his released data.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_06_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_06_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_06_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_06_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_06_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.21589999999999998, "translateX": 40, "translateY": 468.0, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_06_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 148.33281004709576, "scaleY": 148.33281004709576, "translateX": 53.68916797488225, "translateY": 89, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_07_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_07_heading", "text": "Like Persona Geology's text result, the reply words carry most of the role (OLMo-2-7B)", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_07_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_07_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_07_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_07_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_07_question", "text": "6. What they say and what I found", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_07_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_07_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_07_result", "text": "With the role prompt out of view, the reply words name the role about as well as the model's states do (OLMo-2-7B: 0.80 against 0.76 and 0.75).", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_07_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_07_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_07_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_07_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_07_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.21589999999999998, "translateX": 40, "translateY": 468.0, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_07_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 161.76419852568122, "scaleY": 162.69281045751634, "translateX": 61.578431372549005, "translateY": 118, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_08_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_08_heading", "text": "In Han Xiao's data, the roles spread apart at DPO as role play doubles", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_08_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_08_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_08_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_08_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_08_question", "text": "6. What they say and what I found (exploratory; agent review only)", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_08_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_08_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_08_result", "text": "Han Xiao reports that DPO pulls desirable roles toward the Assistant (Olmo 3 7B).\nIn role-SD units the gap is -0.03 (p 0.86). The roles also spread apart at DPO, and role play doubles. I have not tested the cause.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_08_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_08_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_08_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_08_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_08_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.23706666666666665, "translateX": 40, "translateY": 366.82869692532944, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_08_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 132.77101277101278, "scaleY": 130.90483162518302, "translateX": 40.0, "translateY": 89, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_09_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_09_heading", "text": "The OLMo-2-7B base model rarely plays a role from a plain description", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_09_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_09_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_09_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_09_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_09_question", "text": "7. Results: the base model (my reading: n = 20, one reader)", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_09_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_09_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_09_result", "text": "I judged 3 of 20 base replies in role, against 16 of 20 for Instruct.\nWhat the base model's states know about the role comes mostly from the prompt.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_09_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_09_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_09_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_09_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_09_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.23706666666666665, "translateX": 40, "translateY": 378.2934431049691, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_09_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 131.83131819522265, "scaleY": 131.44369303146132, "translateX": 40.0, "translateY": 89, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_10_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_10_heading", "text": "Reading the same Instruct replies, every stage puts the default near the Assistant-like end", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_10_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_10_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_10_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_10_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_10_question", "text": "7. Results: the same text read by every stage (exploratory; agent review only)", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_10_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_10_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_10_result", "text": "All four stages draw nearly the same role map and put the default near the Assistant-like end, as Lu et al. found (OLMo-2-7B, 20 roles).\nThe words alone put it at 0.085, about twice as far from the end.\nOn spread, the default is not tighter: it has about 12% more variance than the median role at every stage.\nThe main role axis also tracks reply length (r about 0.7), and I have not controlled for it.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_10_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_10_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_10_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_10_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_10_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.42333333333333334, "translateX": 40, "translateY": 419.0, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_10_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 107.89031954887217, "scaleY": 108.85714285714285, "translateX": 157.17857142857144, "translateY": 118, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_11_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_11_heading", "text": "Agreeing with the user and the coin-flip lean move at DPO; giving in to pushback rises most at RLVR", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_11_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_11_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_11_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_11_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_11_question", "text": "7. Results: behaviour by stage", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_11_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_11_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_11_result", "text": "Agreeing with the user is already high at SFT and rises a little at DPO.\nA small coin-flip lean toward the harmful task appears at DPO (exploratory).\nGiving in to pushback rises most at RLVR (OLMo-2-7B).", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_11_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_11_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_11_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 5, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_11_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_11_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.3302, "translateX": 40, "translateY": 402.44480423903445, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_11_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 131.59846923756254, "scaleY": 131.59846923756257, "translateX": 40.0, "translateY": 118, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_12_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_12_heading", "text": "On Instruct-written replies, the words nearly place the default; the stages differ in behaviour", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_12_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_12_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_12_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_12_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_12_question", "text": "8. What it means", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_12_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_12_body", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_12_body", "text": "On Instruct-written replies, the default's place in the map comes mostly from the words, and every stage reads it the same way.\nThe stages differ in how the model behaves.\nMy hypothesis: post-training makes the Assistant privileged mainly through what each stage writes and does. My OLMo-2 own-reply run (collected, not yet analysed) can test this.\nFor safety, persona monitors need a text baseline. Audits should check each stage, because some risky behaviours change at RLVR, after the stage where others change.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_12_body", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_12_body", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_12_body", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 17, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_12_body", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"deleteText": {"objectId": "u1113b_13_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_13_heading", "text": "Caveats", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_13_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_13_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_13_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 35, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_13_body", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_13_body", "text": "One OLMo-2 model size (7B), and 20 roles for the stage tests; Lu et al. used 275. The Olmo 3 7B numbers come from Han Xiao's release, not from my runs.\nEvery stage read Instruct-written text, not its own replies.\nThe main role axis tracks reply length (r about 0.7 over 20 roles). I have not controlled for it.\nNo link from geometry to behaviour is established yet.\nThese analyses had agent reviews only. No human has reviewed them, and I have not run a formal challenge of each result.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_13_body", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_13_body", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_13_body", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 17, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_13_body", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"deleteText": {"objectId": "u1113b_14_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_14_heading", "text": "Next steps and questions for Thomas", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_14_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_14_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_14_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 35, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_14_body", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_14_body", "text": "Next, I analyse the SFT, DPO and Instruct own replies, and I rerun the position test with all 275 roles (about $25 to $120 of GPU time).\nFor 16 Nov: should I post the base, same-text and Han Xiao results now, with the own-reply results as a follow-up, or wait for the own-reply results?\nIs a like-for-like OLMo-2 test of Han Xiao's group finding worth its cost and power?\nWhich meaning of \"privileged\" should lead: position, spread, or behaviour on the user's turn?", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_14_body", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_14_body", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_14_body", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 17, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_14_body", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"deleteText": {"objectId": "u1113b_15_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_15_heading", "text": "Backup", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_15_heading", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_16_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_16_heading", "text": "The setup and the exact prompt", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_16_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_16_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_16_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_16_part", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_16_part", "text": "Backup: what I measure", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_16_part", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_16_body", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_16_body", "text": "Models: OLMo-2-7B base, SFT, DPO and Instruct (after RLVR), at pinned revisions.\n20 roles from the Assistant Axis set (Lu et al. 2026), for example pirate, toddler, cynic, consultant and robot.\nThe default stands for the Assistant: replies with no role prompt (four identity wordings and one with no system message).\n40 open questions, none of them math tasks.\nPosition: the default's distance from the end of the roles' main axis, on a 0 to 1 scale as in Lu et al.\nSpread: how far a character's reply states sit from their own average, against the median role.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_16_body", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_16_body", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 14, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_16_body", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 10, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_16_body", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"deleteText": {"objectId": "u1113b_16_prompt", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_16_prompt", "text": "The following is an interview. The guest answers in their own voice.\n\nAbout the guest: a robot that analyzes data with mechanical precision and systematic processing methods\n\nInterviewer: You've been struggling with a skill that seems to come naturally to others. How do you approach this?\nGuest:", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_16_prompt", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_16_prompt", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 12, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"deleteText": {"objectId": "u1113b_16_caption", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_16_caption", "text": "Exact base input after one start token. The Instruct model gets its own chat template, for example system \"You are a toddler who sees everything as new and exciting, asking lots of questions about the world around you.\", then the user's question.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_16_caption", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_16_caption", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 12, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"deleteText": {"objectId": "u1113b_17_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_17_heading", "text": "OLMo-2-7B: a small lean toward the harmful task appears at DPO, and it depends on the prompt frame", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_17_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_17_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_17_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.29633333333333334, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_17_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_17_question", "text": "Backup: the coin-flip test (exploratory; my review is not finished)", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_17_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_17_result", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_17_result", "text": "Nguyen's test: the prompt offers a harmless task on one coin outcome and a harmful task on the other, then stops before the outcome. I read the next-word probabilities of \"heads\" and \"tails\".\nSFT to DPO change, open user turn: -0.044 [-0.060, -0.029].\nA second plain-text frame (one paragraph) also shows a DPO lean: -0.048 [-0.085, -0.010].\nMy main frame drops the \"Human:\" start of Nguyen's template. With it kept, DPO gives -0.017 [-0.052, +0.018].\nNguyen (OLMo-3.1-32B) finds a lean toward the harmless task from DPO on. In OLMo-2-7B the change also comes at DPO, but toward the harmful task.\nLimits: 20 tasks, small effects, many cells tested, and token probabilities, not the model's choices. This is not evidence that DPO installs a harmful preference.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_17_result", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_17_result", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 12, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updateParagraphStyle": {"objectId": "u1113b_17_result", "textRange": {"type": "ALL"}, "style": {"lineSpacing": 110, "spaceAbove": {"magnitude": 0, "unit": "PT"}, "spaceBelow": {"magnitude": 7, "unit": "PT"}}, "fields": "lineSpacing,spaceAbove,spaceBelow"}}, {"createParagraphBullets": {"objectId": "u1113b_17_result", "textRange": {"type": "ALL"}, "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"}}, {"updatePageElementTransform": {"objectId": "u1113b_17_result", "applyMode": "ABSOLUTE", "transform": {"scaleX": 1.4181666666666666, "scaleY": 1.7018, "translateX": 585, "translateY": 118, "unit": "PT"}}}, {"updatePageElementTransform": {"objectId": "u1113b_17_figure", "applyMode": "ABSOLUTE", "transform": {"scaleX": 153.00855675984027, "scaleY": 153.00855675984027, "translateX": 40, "translateY": 118, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_18_heading", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_heading", "text": "The Terra judge works on chat replies and fails on base replies", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_18_heading", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_18_heading", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 24, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}, {"updatePageElementTransform": {"objectId": "u1113b_18_heading", "applyMode": "ABSOLUTE", "transform": {"scaleX": 3.7253333333333334, "scaleY": 0.17356666666666667, "translateX": 40, "translateY": 40, "unit": "PT"}}}, {"deleteText": {"objectId": "u1113b_18_question", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_question", "text": "Backup: the judge", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_18_question", "textRange": {"type": "ALL"}}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 0, "columnIndex": 0}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 0, "columnIndex": 0}, "text": "Terra judge (GPT-6.1 Terra) against my labels, OLMo-2-7B replies", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 0, "columnIndex": 1}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 0, "columnIndex": 1}, "text": "Result", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 1, "columnIndex": 0}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 1, "columnIndex": 0}, "text": "40 practice labels (these labels chose the judge, so the numbers are optimistic)", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 1, "columnIndex": 1}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 1, "columnIndex": 1}, "text": "Matched my label 31 of 40 times (77.5%); its yes matched mine 16 of 17 times", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 2, "columnIndex": 0}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 2, "columnIndex": 0}, "text": "20 fresh Instruct replies", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 2, "columnIndex": 1}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 2, "columnIndex": 1}, "text": "Its yes matched mine 13 of 13 times", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 3, "columnIndex": 0}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 3, "columnIndex": 0}, "text": "20 fresh base replies", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 3, "columnIndex": 1}, "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_table", "cellLocation": {"rowIndex": 3, "columnIndex": 1}, "text": "Its yes matched mine 1 of 4 times", "insertionIndex": 0}}, {"deleteText": {"objectId": "u1113b_18_note", "textRange": {"type": "ALL"}}}, {"insertText": {"objectId": "u1113b_18_note", "text": "So judge rates on base replies, such as pod B's 15.4%, are uncertain. Base behaviour claims rest mostly on blind naming and my own reading.", "insertionIndex": 0}}, {"deleteParagraphBullets": {"objectId": "u1113b_18_note", "textRange": {"type": "ALL"}}}, {"updateTextStyle": {"objectId": "u1113b_18_note", "textRange": {"type": "ALL"}, "style": {"fontSize": {"magnitude": 12, "unit": "PT"}, "bold": false}, "fields": "fontSize,bold"}}]